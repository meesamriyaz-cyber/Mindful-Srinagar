PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mindful_srinagar
# Use a unique secret of at least 32 characters in every environment.
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
CLIENT_ORIGIN=https://clientdemo.cuttingedge-enterprises.in,http://localhost:5173
# Password recovery email (backend only; configure real values in Render).
CLIENT_URL=https://mindfulrehabcentre.in
BREVO_API_KEY=
BREVO_SENDER_EMAIL=enquiry@mindfulrehabcentre.in
BREVO_SENDER_NAME=Mindful Centre
# Used only for first director-account bootstrap; keep empty after setup.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ALLOW_ADMIN_BOOTSTRAP=false

# Cloudinary credentials — backend only. Never expose these as VITE_ variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media upload policy (bytes; defaults are applied by the backend).
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=262144000
MEDIA_IMAGE_BATCH_LIMIT=20
MEDIA_VIDEO_BATCH_LIMIT=3
